# Copy to .env and adjust. Every instance of the stack on the same machine
# needs a unique INSTANCE and APP_PORT.
#
# INSTANCE names both compose projects (<INSTANCE> for the app stack,
# <INSTANCE>-infra for the database and object store), their shared network and
# their volumes. Do not set COMPOSE_PROJECT_NAME: as an environment variable it
# overrides the `name:` in each file and merges the two stacks into one project.
INSTANCE=bbprogress
APP_PORT=8090
DB_NAME=bb
DB_USER=bb
DB_PASSWORD=changeme
TZ=Asia/Singapore

# Where the app finds its database and object store. `db` and `minio` are the service
# names on the shared network created by docker-compose.infra.yml. Point these at an
# external host to use one instead. (Compose interpolates ${DB_NAME} here, so the
# database name stays defined in one place.)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${DB_NAME}

# Photo storage (S3-compatible). The compose stack runs MinIO locally; these are its
# credentials. To use real AWS S3 instead: blank S3_ENDPOINT, set S3_REGION and real keys
# (or leave the keys blank to use an IAM role / AWS profile), set S3_PATH_STYLE=false and
# S3_CREATE_BUCKET=false, then drop the `minio` service from docker-compose.infra.yml.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=bb-progress
S3_ACCESS_KEY=bbprogress
S3_SECRET_KEY=bbprogress-secret
S3_REGION=us-east-1
# Only used by docker-compose.dev.yml (native dev against the containerized DB)
DB_PORT=5433
