# Copy to .env and adjust. Every instance of the stack on the same machine
# needs a unique COMPOSE_PROJECT_NAME and APP_PORT.
COMPOSE_PROJECT_NAME=bbprogress
APP_PORT=8090
DB_NAME=bb
DB_USER=bb
DB_PASSWORD=changeme
TZ=Asia/Singapore

# Photo storage (S3-compatible). The compose stack runs MinIO locally and sets S3_ENDPOINT
# itself; these are its credentials. To use real AWS S3 instead, drop the `minio` service,
# remove S3_ENDPOINT from the app service, and set S3_REGION plus real keys (or leave the
# keys blank to use an IAM role / AWS profile) and S3_PATH_STYLE=false.
S3_BUCKET=bb-progress
S3_ACCESS_KEY=bbprogress
S3_SECRET_KEY=bbprogress-secret
S3_REGION=us-east-1
# Only used by docker-compose.dev.yml (native dev against the containerized DB)
DB_PORT=5433
